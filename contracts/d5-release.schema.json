{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://whalebone.example/contracts/d5-release.schema.json",
  "title": "WhalesIslandReef D5 Release Contract",
  "type": "object",
  "required": ["world", "character", "performance", "steam", "language"],
  "properties": {
    "world": { "$ref": "#/$defs/world_state" },
    "character": { "$ref": "#/$defs/character_state" },
    "performance": { "$ref": "#/$defs/performance_state" },
    "steam": { "$ref": "#/$defs/steam_state" },
    "language": { "enum": ["zh", "en"] },
    "playerTraitIds": { "type": "array", "items": { "type": "string" }, "maxItems": 4 },
    "crewTraitIds": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string" }, "maxItems": 4 } }
  },
  "$defs": {
    "island_definition": {
      "type": "object",
      "required": ["id", "nameZh", "nameEn", "type", "biome", "factionId", "danger", "tradeMultiplier"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "nameZh": { "type": "string", "minLength": 1 },
        "nameEn": { "type": "string", "minLength": 1 },
        "type": { "enum": ["TownPort", "Village", "Wilderness", "Special", "Fortress"] },
        "biome": { "enum": ["Mangrove", "Palm", "Reef", "Rainforest", "Beach"] },
        "factionId": { "type": "string" },
        "danger": { "type": "integer", "minimum": 0, "maximum": 100 },
        "tradeMultiplier": { "type": "number", "minimum": 0.5, "maximum": 2.0 }
      }
    },
    "trait_definition": {
      "type": "object",
      "required": ["id", "nameZh", "nameEn", "category", "modifier", "persona"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "nameZh": { "type": "string" },
        "nameEn": { "type": "string" },
        "category": { "enum": ["Body", "Personality", "Background", "Disease"] },
        "modifier": { "type": "string" },
        "value": { "type": "integer", "minimum": -100, "maximum": 100 },
        "persona": { "type": "string" }
      }
    },
    "character_preset": {
      "type": "object",
      "required": ["id", "nameZh", "nameEn", "skinTone", "hairStyle", "hairColor", "outfit"],
      "properties": {
        "id": { "type": "string" },
        "nameZh": { "type": "string" },
        "nameEn": { "type": "string" },
        "skinTone": { "type": "string" },
        "hairStyle": { "type": "string" },
        "hairColor": { "type": "string" },
        "outfit": { "type": "string" },
        "bodyScale": { "type": "number", "minimum": 0.8, "maximum": 1.2 }
      }
    },
    "world_state": {
      "type": "object",
      "required": ["currentIslandId", "discoveredIslands", "visitedIslands", "mapRevision"],
      "properties": {
        "currentIslandId": { "type": "string" },
        "discoveredIslands": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "visitedIslands": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "mapRevision": { "type": "integer", "minimum": 0 }
      }
    },
    "character_state": {
      "type": "object",
      "required": ["presetId", "skinTone", "hairStyle", "hairColor", "outfit", "faceScale", "bodyScale"],
      "properties": {
        "presetId": { "type": "string" }, "skinTone": { "type": "string" },
        "hairStyle": { "type": "string" }, "hairColor": { "type": "string" },
        "outfit": { "type": "string" }, "faceScale": { "type": "number" }, "bodyScale": { "type": "number" }
      }
    },
    "performance_state": {
      "type": "object",
      "required": ["quality", "targetWidth", "targetHeight", "targetFps", "sampleCount", "meetsTarget"],
      "properties": {
        "quality": { "enum": ["Low", "Medium", "High"] },
        "targetWidth": { "type": "integer", "const": 1920 },
        "targetHeight": { "type": "integer", "const": 1080 },
        "targetFps": { "type": "integer", "const": 60 },
        "lastFps": { "type": "number", "minimum": 0 }, "minFps": { "type": "number", "minimum": 0 },
        "sampleCount": { "type": "integer", "minimum": 0 }, "meetsTarget": { "type": "boolean" }
      }
    },
    "achievement": {
      "type": "object", "required": ["id", "nameZh", "nameEn"],
      "properties": { "id": { "type": "string" }, "nameZh": { "type": "string" }, "nameEn": { "type": "string" } }
    },
    "steam_state": {
      "type": "object",
      "required": ["appId", "offlineMode", "cloudEnabled", "pendingCloudRevision", "lastSync", "unlockedAchievements"],
      "properties": {
        "appId": { "type": "string" }, "offlineMode": { "type": "boolean" },
        "cloudEnabled": { "type": "boolean" }, "pendingCloudRevision": { "type": "integer", "minimum": 0 },
        "lastSync": { "type": "string" },
        "unlockedAchievements": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "store_metadata": {
      "type": "object", "required": ["appName", "shortDescriptionZh", "shortDescriptionEn", "ageRatingNote"],
      "properties": {
        "appName": { "type": "string" }, "shortDescriptionZh": { "type": "string" },
        "shortDescriptionEn": { "type": "string" }, "ageRatingNote": { "type": "string" },
        "supportedLanguages": { "type": "array", "items": { "enum": ["zh-CN", "en"] } }
      }
    }
  }
}
