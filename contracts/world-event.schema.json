{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://whalebone.local/contracts/world-event.schema.json",
  "title": "Whalebone WorldEvent / FactEvent Contract",
  "description": "D8 统一事实事件包。事件日志是单机世界的权威追加源；owner_system 负责领域裁决，事件层只记录结果并提供幂等读取。",
  "type": "object",
  "required": [
    "event_id",
    "schema_version",
    "world_day",
    "location_ref",
    "actor_ids",
    "input_facts",
    "owner_system",
    "result",
    "cause_ids",
    "save_revision",
    "outcome_status"
  ],
  "properties": {
    "event_id": { "type": "string", "minLength": 1 },
    "schema_version": { "const": 1 },
    "world_day": { "type": "integer", "minimum": 0 },
    "location_ref": { "type": "string", "minLength": 1 },
    "actor_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "input_facts": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "owner_system": { "type": "string", "minLength": 1 },
    "result": { "$ref": "#/$defs/event_result" },
    "cause_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "save_revision": { "type": "integer", "minimum": 0 },
    "outcome_status": {
      "type": "string",
      "enum": ["normal", "failed", "cancelled", "interrupted", "recovered"]
    },
    "recovery_route": {
      "anyOf": [
        { "$ref": "#/$defs/recovery_route" },
        { "type": "null" }
      ]
    },
    "log_sequence": { "type": "integer", "minimum": 1 }
  },
  "allOf": [
    {
      "if": { "properties": { "outcome_status": { "const": "failed" } } },
      "then": {
        "required": ["recovery_route"],
        "properties": { "recovery_route": { "$ref": "#/$defs/recovery_route" } }
      }
    },
    {
      "if": { "properties": { "outcome_status": { "const": "interrupted" } } },
      "then": {
        "required": ["recovery_route"],
        "properties": { "recovery_route": { "$ref": "#/$defs/recovery_route" } }
      }
    },
    {
      "if": { "properties": { "outcome_status": { "const": "recovered" } } },
      "then": {
        "properties": { "cause_ids": { "minItems": 1 } }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "event_result": {
      "type": "object",
      "required": ["result_code", "summary", "fact_ids", "values"],
      "properties": {
        "result_code": { "type": "string", "minLength": 1 },
        "summary": { "type": "string" },
        "fact_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "values": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "recovery_route": {
      "type": "object",
      "required": ["route_id", "action"],
      "properties": {
        "route_id": { "type": "string", "minLength": 1 },
        "action": { "type": "string", "minLength": 1 },
        "resume_from_event_id": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
