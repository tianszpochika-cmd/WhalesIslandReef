# ============================================================
# Unity 项目 LFS 规则（game/）
#
# 原则（Unity + Git LFS 标准实践）：
#   - 真正的二进制资产（贴图/模型/音频/字体/包）→ LFS
#   - Unity 文本 YAML 资产（scene/prefab/mat/asset 等）→ 普通 git
#     （保留文本 diff/merge，避免 LFS 锁文件；大型场景后续按需再迁移）
#   - 文本文件统一 CRLF（与 .editorconfig: end_of_line=crlf 一致）
# 新增大类型资产时在此登记（如 *.blend, *.psd）
# ============================================================

# --- 二进制资产 → LFS ---
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.psd filter=lfs diff=lfs merge=lfs -text
*.tga filter=lfs diff=lfs merge=lfs -text
*.tif filter=lfs diff=lfs merge=lfs -text
*.tiff filter=lfs diff=lfs merge=lfs -text
*.exr filter=lfs diff=lfs merge=lfs -text
*.hdr filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.gltf filter=lfs diff=lfs merge=lfs -text
*.glb filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
*.flac filter=lfs diff=lfs merge=lfs -text
*.ttf filter=lfs diff=lfs merge=lfs -text
*.otf filter=lfs diff=lfs merge=lfs -text
*.unitypackage filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text
*.dll filter=lfs diff=lfs merge=lfs -text
*.bundle filter=lfs diff=lfs merge=lfs -text

# --- 文本文件：统一 CRLF（与 .editorconfig: end_of_line=crlf 一致）---
*.cs text eol=crlf
*.json text eol=crlf
*.md text eol=crlf
*.asmdef text eol=crlf
*.rsp text eol=crlf
*.shader text eol=crlf
*.cginc text eol=crlf
*.hlsl text eol=crlf
*.uxml text eol=crlf
*.uss text eol=crlf
*.txt text eol=crlf
*.meta text eol=crlf

# --- Unity YAML 资产：普通 git（文本 diff 友好）---
*.unity text eol=crlf
*.prefab text eol=crlf
*.mat text eol=crlf
*.asset text eol=crlf
*.anim text eol=crlf
*.controller text eol=crlf
*.overrideController text eol=crlf
*.physicMaterial text eol=crlf
*.cubemap text eol=crlf
*.playable text eol=crlf
*.mixer text eol=crlf
*.signal text eol=crlf
*.preset text eol=crlf
*.renderTexture text eol=crlf
*.spriteatlas text eol=crlf
*.tile text eol=crlf
*.brush text eol=crlf
*.terrainlayer text eol=crlf
