# Unity generated
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
/[Tt]errainDataCache/
/[Ss]creenShots/
/ServerData/
/[Cc]aches/

# IDE
.vs/
.idea/
.vscode/
*.suo
*.user
*.userprefs
*.pidb
*.booproj

# Build output
*.apk
*.aab
*.unitypackage
crashlytics-build.properties

# OS
.DS_Store
Thumbs.db

# C# / Visual Studio
# 注意：*.csproj 会误伤手写工程 game/AgentCore/AgentCore.csproj（独立 dotnet build 用），
# 该例外在 game/.gitignore 中以 !AgentCore.csproj 恢复。
*.csproj
*.sln
*.pdb
*.mdb
*.opendb
*.VC.db
sysinfo.txt

# Node / TypeScript（server & web）
node_modules/
dist/
coverage/
*.tsbuildinfo
.env
.env.*
!.env.example
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local config
*.local

# Local diagnostic output and scratch Unity projects
/ops/logs/
/ops/p1c_scratch/

# Codex temporary compilation and regression workspaces
/.codex-temp/

# D18 external asset source cache: keep provenance manifests/evidence in docs,
# but never add downloaded archives to ordinary Git history.
/artifacts/external_sources/*.zip
/artifacts/external_sources/*.7z
/artifacts/external_sources/*.rar
/artifacts/external_sources/*.tar
/artifacts/external_sources/*.gz

# Generated validation fixtures, Player builds, and Python bytecode are reproducible.
# Keep their compact reports under tools/results and docs, not full runtime caches.
/artifacts/
/+/
**/__pycache__/

# Unity audit fixtures and standalone Player copies are regenerated from the
# project. Keep their reports and screenshots, but never commit nested caches.
/game/tools/results/**/_Unity*FixtureProject/
/game/tools/results/**/_UnityAuditFixtureProject/
/game/tools/results/**/UnityAuditProject*/
/game/tools/results/**/[Ll]ibrary/
/game/tools/results/**/[Tt]emp/
/game/tools/results/**/[Ll]ogs/
/game/tools/results/**/[Pp]ackageCache/
/game/tools/results/**/[Mm]onoBleedingEdge/
**/[Bb]in/
**/[Oo]bj/
/game/tools/results/**/*_Data/
/game/tools/results/**/*_BurstDebugInformation_DoNotShip/
/game/tools/results/**/*.exe
/game/tools/results/**/*.dll
