# Whalebone 服务端环境变量（复制为 .env 后填写，.env 不入库）
# 本地开发可不配置，代码提供默认值/占位；生产必须全量配置。

PORT=3000

# PostgreSQL（Prisma 连接串）
DATABASE_URL=postgres://user:pass@localhost:5432/whalebone

# Redis（限流/会话缓存）
REDIS_URL=redis://localhost:6379

# 会话签名（生产用随机长串）
JWT_SECRET=change-me

# 本地 LLM（Ollama）
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b

# 云端 LLM（可空，为空则只走本地）
DEEPSEEK_API_KEY=

# Steam 关联登录（Steamworks 后台获取，可后置）
STEAM_WEB_API_KEY=
